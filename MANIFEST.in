include LICENSE NOTICE README.md run_patent_sar.sh .env.example
recursive-include docs *.md
recursive-include src/patent_sar_extractor/defaults *.yaml
recursive-include src/patent_sar_extractor/core/ocsr *.yaml
recursive-include examples *.yaml
recursive-include tests *.py
recursive-include tools *.py
include frontend/*.json frontend/*.ts frontend/index.html
include frontend/.oxlintrc.json frontend/.prettierrc.json frontend/.prettierignore frontend/.gitignore
recursive-include frontend/src *.ts *.tsx *.css *.svg
recursive-include frontend/tests *.ts *.tsx
recursive-include src/patent_sar_extractor/web/static *

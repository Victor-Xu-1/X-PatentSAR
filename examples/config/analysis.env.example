# Additive operator environment template; it does not replace .env.example or
# existing env_paths.local.yaml. Source it only in the local main Web launcher.
# Interpreter/model values below are this workstation's E-drive deployment.
PATENTSAR_ADMET_PYTHON=/srv/wsl/envs/x-patentsar-admet/bin/python
PATENTSAR_ADMET_MODEL_DIR=/srv/wsl/models/patentsar/admet-ai/2.0.1
# DECIMER continues to use the existing interpreter authority and existing models.
DECIMER_PYTHON=/home/victor_1/miniconda3/envs/decimer/bin/python
PYSTOW_HOME=/srv/wsl/models/patentsar


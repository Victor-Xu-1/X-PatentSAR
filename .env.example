# Credentials are read from the environment; never commit real values.
LLM_API_KEY=
LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=ark-code-latest
VLM_API_KEY=
VLM_API_URL=
VLM_MODEL=

# Optional local-evidence review: OFF never sends patent evidence or reads credentials.
# Explicit operator setup and disclosure consent are both required to enable it.
# on-error reviews unresolved evidence; quality also audits bounded column candidates.
# Uses the above HTTPS OpenAI-compatible LLM provider, not a second model service.
PATENTSAR_LLM_RESOLUTION_MODE=off
PATENTSAR_LLM_RESOLUTION_DATA_CONSENT=false
PATENTSAR_LLM_RESOLUTION_MAX_CALLS=8
PATENTSAR_LLM_RESOLUTION_TIMEOUT=30
PATENTSAR_LLM_RESOLUTION_RETRIES=0
PATENTSAR_LLM_RESOLUTION_MAX_INPUT_CHARS=12000
PATENTSAR_LLM_RESOLUTION_MAX_OUTPUT_CHARS=8192
PATENTSAR_LLM_RESOLUTION_MAX_TOKENS=1024

# Optional external configuration directory for installed wheels.
PATENTSAR_CONFIG_DIR=

# Optional runtime-state root. Defaults to
# ${XDG_STATE_HOME:-~/.local/state}/patent-sar-extractor.
PATENTSAR_STATE_DIR=

# Web projects, sessions, jobs, reviews and uploads; defaults to state_dir()/web.
PATENTSAR_WEB_STATE_DIR=

# Optional environment manager. New prefixes are restricted to this Linux root.
# E-drive WSL deployment uses /srv/wsl/envs and /srv/wsl/envs/x-patentsar-managed.
# Empty values use a private managed subdirectory under the Web state root.
PATENTSAR_ENVIRONMENT_ALLOWED_ROOT=
PATENTSAR_ENVIRONMENT_ROOT=
# Optional approved native data root for user-selected uploads/results.
# Defaults to the Web state root's parent; this workstation uses /srv/wsl/data/patentsar.
# Browser settings select dedicated private directories under it, never a network/Windows mount.
PATENTSAR_DATA_ALLOWED_ROOT=
# Optional verified uv 0.11.31. Other/global uv versions are never modified.
PATENTSAR_ENVIRONMENT_UV=

# Leave unused overrides empty so operator env_paths.local.yaml takes effect.
# The application is Python 3.12; DECIMER requires an isolated Python 3.10.
PATENTSAR_PYTHON=
PATENTSAR_BASE_PYTHON=
SMILES_ENGINE_PYTHON=
DECIMER_PYTHON=
PADDLEOCR_PYTHON=
PYMUPDF_PYTHON=

# DECIMER OCSR model storage (pystow). Set an operator-owned E-drive path.
PYSTOW_HOME=

# Optional local PaddleX OCR HTTP endpoint.
PATENTSAR_PADDLEX_OCR_URL=off

# Optional strict/runtime controls.
PATENTSAR_STRICT_GATES=1
PATENTSAR_STRUCTURE_CHUNK_SIZE=10
# DECIMER inference is one owned model queue; this bounds intra-op CPU threads (1-16).
PATENTSAR_DECIMER_CPU_THREADS=2
# Resident model limit (MiB). Insufficient headroom fails visibly before loading.
PATENTSAR_DECIMER_MAX_RSS_MB=4096
PATENTSAR_ALLOW_TESSERACT_FALLBACK=0
PATENTSAR_TESSERACT_LANG=chi_sim+eng
